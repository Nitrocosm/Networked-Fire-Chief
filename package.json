{
  "name": "fire-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run golden",
    "lint": "eslint . && pnpm run lint:deps",
    "lint:deps": "depcruise packages --config .dependency-cruiser.cjs",
    "test:crossengine": "playwright test",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.7.0",
    "dependency-cruiser": "^16.4.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
